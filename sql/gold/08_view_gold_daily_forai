-- 1. Створюємо таблицю для згорнутих денних контекстів
CREATE TABLE IF NOT EXISTS gold_ai_daily_compressed (
    summary_date DATE PRIMARY KEY,

    -- Зібрані погодинні метрики (всі 24 значення в одній клітинці)
    hours_list TEXT,
    steps_hourly TEXT,
    heart_rate_hourly TEXT,
    calories_hourly TEXT,
    exercise_hourly TEXT,
    screentime_hourly TEXT,
    music_hourly TEXT,

    -- Денний макроконтекст (дублюється з gold_daily_summary для зручності)
    sleep_duration_min INT,
    deep_sleep_min INT,
    rem_sleep_min INT,
    sleep_onset_time TIMESTAMP,
    sleep_wake_time TIMESTAMP,
    hrv_rmssd NUMERIC,
    overall_score INT,
    energy INT,
    mood INT,
    stress INT,
    productivity INT,
    journal_tags TEXT,
    journal_content TEXT,
    total_screentime_min INT,
    productive_screentime_min INT,
    total_tracks_played INT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Скрипт заповнення таблиці (наприклад, для вчорашнього дня)
INSERT INTO gold_ai_daily_compressed (
    summary_date,
    hours_list,
    steps_hourly,
    heart_rate_hourly,
    calories_hourly,
    exercise_hourly,
    screentime_hourly,
    music_hourly,
    sleep_duration_min,
    deep_sleep_min,
    rem_sleep_min,
    sleep_onset_time,
    sleep_wake_time,
    hrv_rmssd,
    overall_score,
    energy,
    mood,
    stress,
    productivity,
    journal_tags,
    journal_content,
    total_screentime_min,
    productive_screentime_min,
    total_tracks_played
)
SELECT
    "Дата" AS summary_date,
    string_agg("Година", ' | ' ORDER BY "Година") AS hours_list,
    string_agg("Кроки за годину"::text, ' | ' ORDER BY "Година") AS steps_hourly,
    string_agg(COALESCE("Сер. пульс"::text, '-'), ' | ' ORDER BY "Година") AS heart_rate_hourly,
    string_agg(COALESCE("Ккал"::text, '0'), ' | ' ORDER BY "Година") AS calories_hourly,
    string_agg("Хв тренувань"::text, ' | ' ORDER BY "Година") AS exercise_hourly,
    string_agg("Використані додатки та хвилини", ' || ' ORDER BY "Година") AS screentime_hourly,
    string_agg("Прослухані треки", ' || ' ORDER BY "Година") AS music_hourly,

    MAX("Сон загалом (хв)"),
    MAX("Глибокий сон (хв)"),
    MAX("REM сон (хв)"),
    MAX("Час засинання"::timestamp),
    MAX("Час прокидання"::timestamp),
    MAX("HRV (день)"),
    MAX("Оцінка дня"),
    MAX("Енергія (щоденник)"),
    MAX("Настрій (щоденник)"),
    MAX("Стрес (щоденник)"),
    MAX("Продуктивність (щоденник)"),
    MAX("Теги щоденника"),
    MAX("Текст щоденника"),
    MAX("Загальний екранний час (день)"),
    MAX("Продуктивний екранний час (день)"),
    MAX("Прослухано треків (день)")
FROM gold_ai_yesterday_hourly_summary
GROUP BY "Дата"
ON CONFLICT (summary_date) DO UPDATE SET
    hours_list = EXCLUDED.hours_list,
    steps_hourly = EXCLUDED.steps_hourly,
    heart_rate_hourly = EXCLUDED.heart_rate_hourly,
    calories_hourly = EXCLUDED.calories_hourly,
    exercise_hourly = EXCLUDED.exercise_hourly,
    screentime_hourly = EXCLUDED.screentime_hourly,
    music_hourly = EXCLUDED.music_hourly,
    sleep_duration_min = EXCLUDED.sleep_duration_min,
    overall_score = EXCLUDED.overall_score,
    journal_content = EXCLUDED.journal_content;